{
	"name": "2026",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"scripts": {
		"watch:plugin": "vite build --watch --mode development --config wp/wp-content/plugins/hda/vite.config.ts",
		"build:plugin": "vite build --mode production --config wp/wp-content/plugins/hda/vite.config.ts",
		"watch:theme": "vite build --watch --mode development --config wp/wp-content/themes/hd/vite.config.ts",
		"build:theme": "vite build --mode production --config wp/wp-content/themes/hd/vite.config.ts",
		"watch": "concurrently \"pnpm watch:plugin\" \"pnpm watch:theme\"",
		"build": "pnpm build:plugin && pnpm build:theme"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"devDependencies": {
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.2.1",
		"@vheemstra/vite-plugin-imagemin": "^2.2.1",
		"@wordpress/browserslist-config": "^6.41.0",
		"autoprefixer": "^10.4.27",
		"concurrently": "^9.2.1",
		"imagemin-gifsicle": "^7.0.0",
		"imagemin-mozjpeg": "^10.0.0",
		"imagemin-pngquant": "^10.0.0",
		"imagemin-svgo": "^11.0.1",
		"imagemin-webp": "^8.0.0",
		"postcss": "^8.5.8",
		"sass": "^1.97.3",
		"tailwindcss": "^4.2.1",
		"terser": "^5.46.0",
		"vite": "^7.3.1",
		"vite-plugin-static-copy": "^3.2.0"
	},
	"dependencies": {
		"@fancyapps/ui": "^6.1.13",
		"canvas-confetti": "^1.9.4",
		"ensemble": "github:loltgt/ensemble",
		"ensemble-social-share": "github:loltgt/ensemble-social-share",
		"gsap": "^3.14.2",
		"nanoid": "^5.1.6",
		"qrcode-generator": "^2.0.4",
		"select2": "4.1.0-rc.0",
		"simplebar": "^6.3.3",
		"sweetalert2": "^11.26.21",
		"swiper": "^12.1.2",
		"three": "^0.183.2",
		"vanilla-lazyload": "^19.1.3"
	}
}
