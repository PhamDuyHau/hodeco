{
	"name": "hd/theme",
	"description": "HD WordPress Theme with custom architecture",
	"type": "wordpress-theme",
	"license": "MIT",
	"authors": [
		{
			"name": "HD",
			"email": "dungnq.dev@gmail.com"
		}
	],
	"autoload": {
		"psr-4": {
			"HD\\": "src/",
			"HD\\App\\": "app/"
		},
		"files": [
			"app/helpers.php",
			"app/setup.php",
			"app/template-hooks.php"
		]
	},
	"require": {
		"php": ">=8.3",
		"matthiasmullie/minify": "^1.3"
	},
	"require-dev": {
		"roave/security-advisories": "dev-latest"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"optimize-autoloader": true,
		"classmap-authoritative": true,
		"preferred-install": "dist",
		"sort-packages": true
	},
	"scripts": {
		"post-install-cmd": [
			"composer dump-autoload -o"
		],
		"post-update-cmd": [
			"composer dump-autoload -o"
		]
	}
}
